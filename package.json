{
  "name": "taxi-booking-app",
  "version": "1.0.0",
  "description": "A taxi booking application where passengers can book rides, drivers can select bookings, and both parties can rate each other after journey completion.",
  "main": "server/index.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "nodemon server/index.js",
    "dev:client": "next dev",
    "build": "npm run build:server && npm run build:client",
    "build:server": "echo \"No server build step\"",
    "build:client": "next build",
    "start": "NODE_ENV=production node server/index.js",
    "test": "jest"
  },
  "dependencies": {
    "axios": "^0.24.0",
    "express": "^4.18.2",
    "mysql2": "^3.1.0",
    "jsonwebtoken": "^9.0.0",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.0.3",
    "concurrently": "^8.0.1",
    "next": "^13.4.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "jest": "^29.5.0",
    "nodemon": "^2.0.22"
  },
  "jest": {
    "testEnvironment": "node",
    "moduleFileExtensions": ["js", "jsx"],
    "testMatch": ["**/tests/unit/**/*.test.js"]
  },
  "author": "Your Name",
  "license": "MIT"
}